<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>true</IsPackable>

		<!-- NuGet package metadata -->
		<PackageId>NTokenizers.Extensions.Spectre.Console</PackageId>
		<VersionSuffix Condition="'$(VersionSuffix)' == ''">preview</VersionSuffix>
		<Version>3.0</Version>
		<Authors>crwsolutions</Authors>
		<Copyright>(c) crwsolutions</Copyright>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<Description>Stream-capable Spectre.Console rendering extensions for NTokenizers (XML, JSON, Markdown, TypeScript, CSS, HTML, C#, SQL, TOML, C, C++, Go, Java, Kotlin, Python, Rust and Swift), Style-rich console syntax highlighting</Description>
		<PackageDescription>Stream-capable Spectre.Console rendering extensions for NTokenizers (XML, JSON, Markdown, TypeScript, CSS, HTML, C#, SQL, TOML, C, C++, Go, Java, Kotlin, Python, Rust and Swift), Style-rich console syntax highlighting</PackageDescription>
		<PackageTags>tokenizer;xml;json;md;markdown;typescript;css;html;c#;csharp;sql;toml;c;c++;cpp;go;java;kotlin;python;rust;swift;stream;streaming;parse;parsing;dotnet;spectre.console;console;highlighting</PackageTags>
		<RepositoryUrl>https://github.com/crwsolutions/NTokenizers.Extensions.Spectre.Console</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageProjectUrl>https://crwsolutions.github.io/NTokenizers.Extensions.Spectre.Console</PackageProjectUrl>
		<Title>NTokenizers.Extensions.Spectre.Console</Title>
		<PackageReleaseNotes>This release upgrades to NTokenizers 8.0 and adds styles for the two Markdown token types it introduces, so combined emphasis and strikethrough render styled instead of falling back to the default style.

## Markdown

- New `MarkdownStyles.BoldItalic` style (blue, bold + italic decoration) for the combined `***bold italic***` / `___bold italic___` emphasis syntax.
- New `MarkdownStyles.Strikethrough` style (grey, strikethrough decoration) for the `~~strikethrough~~` syntax.
- Both styles are applied in paragraphs, headings, quotes, list items (through `MarkdownStyles.GetStyleForToken`) and in table cells.

## Dependencies

- Upgraded to NTokenizers 8.0.</PackageReleaseNotes>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="NTokenizers" Version="8.*" />
		<PackageReference Include="Spectre.Console" Version="0.57.2" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>
</Project>